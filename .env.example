# ── Server & Security ──────────────────────────────────────────
PORT=3000
APP_ID=aiplanner
APP_SECRET=your-secret-key-change-me

# ── Database (MySQL) ───────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/aiplanner

# ── Optional AI Configuration ──────────────────────────────────
# Leave blank to configure interactively via the in-app Settings UI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Optional Google / Gmail Integration ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
